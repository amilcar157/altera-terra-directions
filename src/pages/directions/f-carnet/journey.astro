---
const __rawBase = import.meta.env.BASE_URL;
const __base = __rawBase.endsWith("/") ? __rawBase.slice(0, -1) : __rawBase;
import SEOHead from "../../../components/SEOHead.astro";
import LangSwitcher from "../../../components/LangSwitcher.astro";
import FCarnetFonts from "../../../components/fonts/FCarnetFonts.astro";
import "../../../styles/base.css";
import "../../../styles/f-carnet.css";
import { CTA_PRIMARY, JOURNEYS } from "../../../data/brand";
import { PHOTOS, unsplashUrl, unsplashSrcSet } from "../../../data/images";

const journey = JOURNEYS.kyoto;
const others = [
  { ...JOURNEYS.karo, photo: PHOTOS.fSafari },
  { ...JOURNEYS.cyclades, photo: PHOTOS.fTable },
];
---
<!doctype html>
<html lang="en">
<head>
  <SEOHead
    title={`Altera Terra — Carnet de Voyage | ${journey.title}`}
    description={`${journey.title}: ${journey.dek} A journey composed to order by Altera Terra — no price list, only the shape of what you need.`}
    path="/directions/f-carnet/journey/"
  />
  <FCarnetFonts />
</head>
<body class="dir-f">
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="site-nav">
    <div class="container">
      <a href={`${__base}/directions/f-carnet/`} class="wordmark">Altera Terra <em>Carnet</em></a>
      <nav class="nav-links" aria-label="Primary">
        <a href={`${__base}/directions/f-carnet/`}>Home</a>
        <a href={`${__base}/directions/f-carnet/journey/`} aria-current="page">Journey</a>
        <a href={`${__base}/directions/f-carnet/enquire/`}>Enquire</a>
      </nav>
      <div class="nav-right">
        <LangSwitcher current="en" />
        <button class="hamburger" aria-expanded="false" aria-controls="mobile-menu" id="menu-toggle">
          <span class="sr-only">Open menu</span>
          ☰
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="mobile-menu" data-open="false" aria-label="Mobile">
      <a href={`${__base}/directions/f-carnet/`}>Home</a>
      <a href={`${__base}/directions/f-carnet/journey/`}>Journey</a>
      <a href={`${__base}/directions/f-carnet/enquire/`}>Enquire</a>
    </nav>
  </header>

  <main id="main">
    <section class="cover journey-cover">
      <img
        src={unsplashUrl(PHOTOS.fKyoto.id, 1600)}
        srcset={unsplashSrcSet(PHOTOS.fKyoto.id, [640, 960, 1280, 1600, 1920])}
        sizes="100vw"
        alt={journey.alt}
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="container cover-content">
        <p class="kicker">Field Notes — {journey.place}</p>
        <h1>{journey.title}</h1>
      </div>
    </section>

    <div class="container">
      <section class="standfirst-block">
        <p class="byline">The Brief</p>
        <hr class="masthead-rule" />
        <p>{journey.forWhom}</p>
        <p style="font-style: italic; opacity:.75; margin-top: 1rem;">
          Composed to order — there is no price list, only the shape of what a family like this one needs.
        </p>
        <ul class="pillar-chips" aria-label="Pillars involved in this journey">
          {journey.pillarsInvolved.map((p) => <li>{p}</li>)}
        </ul>
      </section>

      <section class="article" aria-labelledby="moments-heading">
        <p class="byline">Five Moments</p>
        <hr class="masthead-rule" />
        <h2 id="moments-heading" class="sr-only">How the five days were composed</h2>
        <ol class="moments-list" style="list-style:none;">
          {journey.moments?.map((m, i) => (
            <li class="moment">
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{m.title}</h3>
                <p>{m.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="article" aria-labelledby="others-heading" style="border-bottom:none;">
        <p class="byline">Also In This Issue</p>
        <hr class="masthead-rule" />
        <h2 id="others-heading" class="sr-only">Other journeys we have composed</h2>

        {others.map((o, i) => (
          <div class={`article-grid ${i % 2 === 1 ? "reverse" : ""}`} style="margin-bottom: 2.5rem;">
            <figure class="figure">
              <img
                src={unsplashUrl(o.photo.id, 800)}
                srcset={unsplashSrcSet(o.photo.id, [400, 600, 800, 1000])}
                sizes="(min-width: 860px) 50vw, 100vw"
                alt={o.alt}
                loading="lazy"
                width="800"
                height="600"
              />
              <figcaption>{o.place}</figcaption>
            </figure>
            <div class="article-body">
              <h2>{o.title}</h2>
              <p>{o.dek}</p>
            </div>
          </div>
        ))}

        <a class="cta" href={`${__base}/directions/f-carnet/enquire/`}>{CTA_PRIMARY}</a>
      </section>
    </div>
  </main>

  <footer class="dir-f-footer">
    <div class="container">
      <p>© {new Date().getFullYear()} Altera Terra. <a href={`${__base}/directions/f-carnet/enquire/#houses`}>Our houses</a>.</p>
      <p>Paris · Madrid · Athens</p>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    toggle?.addEventListener("click", () => {
      const open = menu?.getAttribute("data-open") === "true";
      menu?.setAttribute("data-open", String(!open));
      toggle.setAttribute("aria-expanded", String(!open));
    });
  </script>
</body>
</html>
